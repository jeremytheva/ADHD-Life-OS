# Browser-visible paths for the same-origin NoCodeBackend proxy.
VITE_AUTH_PROXY_URL=/api/ncb/auth
VITE_DATA_PROXY_URL=/api/ncb/data

# Server/runtime-only NoCodeBackend configuration. Do not expose these through VITE_*.
# Base URLs identify provider services only. Generated data operation paths/methods
# must be certified for the target instance before api/ncb/dataProviderContract.js
# is marked VERIFIED.
NOCODEBACKEND_AUTH_BASE_URL=https://app.nocodebackend.com/api/user-auth
NOCODEBACKEND_DATA_BASE_URL=https://api.nocodebackend.com/
NOCODEBACKEND_SECRET_KEY=your-server-only-secret-key
NOCODEBACKEND_INSTANCE=your-instance-name

# Server-only NoCodeBackend identities/credentials for connected provider
# administration/certification. Names are canonical and must not contain spaces.
# Do not expose these through VITE_*.
NOCODEBACKEND_USER_EMAIL=your-provider-user@example.com
NOCODEBACKEND_USER_SECRET_KEY=your-server-only-user-secret-key
NOCODEBACKEND_ADMIN_EMAIL=your-provider-admin@example.com
NOCODEBACKEND_ADMIN_SECRET_KEY=your-server-only-admin-secret-key

# Build-time diagnostic override. Production source maps are disabled by default.
# Enable only for a controlled diagnostic build and do not expose generated maps publicly.
ENABLE_PRODUCTION_SOURCEMAPS=false

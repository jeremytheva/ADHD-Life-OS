# Browser-visible paths for the same-origin NoCodeBackend proxy.
VITE_AUTH_PROXY_URL=/api/ncb/auth
VITE_DATA_PROXY_URL=/api/ncb/data

# Server/runtime-only NoCodeBackend configuration. Do not expose these through VITE_*.
# Supply the exact verified upstream bases for this project; do not infer provider routes.
NOCODEBACKEND_AUTH_BASE_URL=https://your-auth-provider.example.com
NOCODEBACKEND_DATA_BASE_URL=https://your-data-provider.example.com/data
NOCODEBACKEND_SECRET_KEY=your-server-only-secret-key
NOCODEBACKEND_INSTANCE=your-instance-name

# Build-time diagnostic override. Production source maps are disabled by default.
# Enable only for a controlled diagnostic build and do not expose generated maps publicly.
ENABLE_PRODUCTION_SOURCEMAPS=false

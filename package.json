{
  "name": "adhd-life-os-mvp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:error": "eslint . --quiet",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:e2e": "playwright test",
    "inspect:ncb-openapi": "node scripts/inspect-ncb-openapi.mjs",
    "certify:ncb-read": "node scripts/certify-ncb-read.mjs",
    "certify:execution-sessions": "node scripts/certify-execution-sessions.mjs",
    "validate:governance": "node scripts/validate-governance.mjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "platform:validate": "npm audit --audit-level=moderate && npm run validate:governance && npm run validate && npm run test:e2e"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
